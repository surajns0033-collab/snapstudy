# ---------------------------------------------------------------------------
# SnapStudy environment configuration
# Copy this file to `.env.local` and fill in your own values.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# REQUIRED — server-only API key for the Gemini API.
# Get one from Google AI Studio: https://aistudio.google.com/app/apikey
# This key is read on the server only and is NEVER exposed to the browser.
GEMINI_API_KEY=

# OPTIONAL — the Gemma model identifier used for study-kit generation.
# Gemma 4 is the core intelligence of this app. Defaults to gemma-4-26b-a4b-it.
# Override only to target a different Gemma 4 variant available to your key.
GEMMA_MODEL=gemma-4-26b-a4b-it
